{
  "id": "./",
  "name": "Radpausen",
  "short_name": "Radpausen",
  "description": "Bäcker, Supermärkte, Wasser, Schutzhütten und mehr entlang deiner GPX-Radroute – offline, mit Öffnungszeiten bei Ankunft. Daten: OpenStreetMap.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1f6f4a",
  "theme_color": "#1f6f4a",
  "lang": "de",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{"name": "gpx", "accept": [".gpx", "application/gpx+xml", "application/xml", "text/xml", "application/octet-stream"]}]
    }
  },
  "file_handlers": [
    {"action": "./", "accept": {"application/gpx+xml": [".gpx"]}}
  ]
}
